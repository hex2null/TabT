# Rust build output
/target/
*.rs.bk

# Build output: the app bundles (`make release` produces dist/TabT.app, `make`/`make run` the
# dev-named one) and the installer disk images (`make dmg`, or with OUTDIR pointed elsewhere)
/dist/
*.dmg

# Local signing/notarization credentials (SIGN_ID, NOTARY_PROFILE, ...)
.env
.env.local

# macOS junk
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# Editor/IDE local state
.vscode/
.idea/
*.swp
*~

# Claude Code local/personal files (the shared CLAUDE.md and skills stay tracked; ignore the rest)
.claude/*
!.claude/skills/
CLAUDE.local.md
