# Rust build output
/target/
*.rs.bk

# Built app bundles (`make release` produces TabT.app, `make`/`make run` the dev-named one)
/TabT.app/
/TabT Dev.app/

# Installer disk images (produced by `make dmg`, or with OUTDIR pointed elsewhere)
/dist/
*.dmg

# Local signing/notarization credentials (SIGN_ID, NOTARY_PROFILE, ...)
.env
.env.local

# macOS junk
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# Editor/IDE local state
.vscode/
.idea/
*.swp
*~

# Claude Code local/personal files (the shared CLAUDE.md and skills stay tracked; ignore the rest)
.claude/*
!.claude/skills/
CLAUDE.local.md
